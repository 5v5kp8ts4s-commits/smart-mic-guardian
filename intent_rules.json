{
  "version": "1.0",
  "description": "智能防误关麦助手 - NLP 意图关键词规则库",
  "rules": [
    {
      "intent": "leave",
      "label": "请假/退出",
      "action": "stop_remind",
      "keywords": [
        "不好意思",
        "先下线",
        "退出会议",
        "退出",
        "离开",
        "有事离开",
        "我先走",
        "下次再聊",
        "散会",
        "结束"
      ],
      "description": "命中后判定用户主动下线，不再持续弹窗提醒"
    },
    {
      "intent": "inquiry",
      "label": "询问",
      "action": "reset_timer",
      "keywords": [
        "听得到吗",
        "能听见吗",
        "在吗",
        "听得见吗",
        "可以听到吗",
        "能听清吗",
        "听得清吗",
        "有人在吗",
        "大家能听到吗"
      ],
      "description": "命中后重置静音计时器，重新开始计时"
    },
    {
      "intent": "speak",
      "label": "发言",
      "action": "reset_timer",
      "keywords": [
        "我说一下",
        "补充一点",
        "我来补充",
        "我发言",
        "我讲一下",
        "我说两句",
        "我再补充",
        "我补充一下",
        "接下来说",
        "接下来我",
        "我来说"
      ],
      "description": "命中后重置静音计时器，重新开始计时"
    },
    {
      "intent": "foreshadow",
      "label": "铺垫/提问",
      "action": "mark_ready",
      "keywords": [
        "接下来",
        "顺带说下",
        "顺便提一下",
        "顺带说",
        "还有一件事",
        "关于这个",
        "另外",
        "顺便说",
        "补充说明",
        "最后一点",
        "提一点"
      ],
      "description": "标记即将发言状态，用于发言预测模块"
    },
    {
      "intent": "rest",
      "label": "离场/休息",
      "action": "block_alert",
      "keywords": [
        "我先静音",
        "暂时不说",
        "休息一下",
        "静音片刻",
        "稍等片刻",
        "我先闭麦",
        "关麦休息",
        "暂停发言"
      ],
      "description": "判定用户主动闭麦休息，后续关麦后动态屏蔽弹窗提醒"
    }
  ]
}

